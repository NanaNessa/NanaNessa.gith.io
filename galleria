<script>
// ============================================
// FIREBASE CONFIG
// ============================================
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_PROJECT.firebaseapp.com",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_PROJECT.appspot.com",
  messagingSenderId: "YOUR_SENDER_ID",
  appId: "YOUR_APP_ID"
};

firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();

// ============================================
// ADMIN LOGIN
// ============================================
const urlParams = new URLSearchParams(window.location.search);
const isAdmin = urlParams.get('admin') === 'true' || window.location.pathname.includes('/admin');

if (isAdmin) {
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('siteContent').classList.add('hidden');

  auth.onAuthStateChanged(user => {
    if (user) {
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('adminPanel').classList.add('active');
      loadAdminData();
    }
  });

  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('loginEmail').value;
    const password = document.getElementById('loginPassword').value;
    
    try {
      await auth.signInWithEmailAndPassword(email, password);
    } catch (error) {
      alert('Login fallito: ' + error.message);
    }
  });

  document.getElementById('logoutBtn').addEventListener('click', async () => {
    await auth.signOut();
    window.location.href = '/';
  });
}

// ============================================
// LOAD SITE DATA
// ============================================
async function loadSiteData() {
  try {
    const doc = await db.collection('site').doc('config').get();
    if (doc.exists) {
      const data = doc.data();
      
      // Colori
      if (data.colors) {
        document.documentElement.style.setProperty('--bg', data.colors.bg);
        document.documentElement.style.setProperty('--fg', data.colors.fg);
        document.documentElement.style.setProperty('--accent', data.colors.accent);
      }
      
      // Hero
      if (data.hero) {
        document.getElementById('siteHeroTitle').textContent = data.hero.title;
        document.getElementById('siteHeroSubtitle').textContent = data.hero.subtitle;
      }
      
      // Eventi
      if (data.events) {
        renderEvents(data.events);
        renderTicker(data.events);
      }
      
      // Contatti
      if (data.contacts) {
        document.getElementById('siteAddress').innerHTML = data.contacts.address;
        document.getElementById('siteEmail').textContent = data.contacts.email;
        document.getElementById('siteHours').textContent = data.contacts.hours;
      }
      
      // Prezzo
      if (data.stripe && data.stripe.price) {
        document.getElementById('displayPrice').textContent = '€' + data.stripe.price;
      }
    }
  } catch (error) {
    console.log('Usando dati default');
    renderDefaultEvents();
  }
}

function renderEvents(events) {
  const container = document.getElementById('eventsListSite');
  container.innerHTML = events.map(e => `
    <div class="event-card">
      <div class="event-date">${e.date}</div>
      <div>
        <div class="event-title">${e.title}</div>
        <div class="event-desc">${e.desc}</div>
      </div>
      <div class="event-tag">${e.tag}</div>
    </div>
  `).join('');
}

function renderTicker(events) {
  const track = document.getElementById('tickerTrack');
  const items = events.map(e => `
    <div class="ticker-item">
      <span class="date">${e.date}</span>
      ${e.title}
    </div>
  `).join('');
  track.innerHTML = items + items;
}

function renderDefaultEvents() {
  const defaultEvents = [
    { date: '12.12', title: 'Radici Invisibili', desc: 'Mostra collettiva', tag: 'Mostra' },
    { date: '18.01', title: 'Frequenze Notturne', desc: 'Live performance', tag: 'Performance' },
    { date: '02.02', title: 'Open Studio', desc: 'Porte aperte', tag: 'Open' }
  ];
  renderEvents(defaultEvents);
  renderTicker(defaultEvents);
}

// ============================================
// ADMIN FUNCTIONS
// ============================================
async function loadAdminData() {
  try {
    const doc = await db.collection('site').doc('config').get();
    if (doc.exists) {
      const data = doc.data();
      
      if (data.colors) {
        document.getElementById('colorBg').value = data.colors.bg;
        document.getElementById('colorFg').value = data.colors.fg;
        document.getElementById('colorAccent').value = data.colors.accent;
      }
      
      if (data.hero) {
        document.getElementById('heroTitle').value = data.hero.title;
        document.getElementById('heroSubtitle').value = data.hero.subtitle;
      }
      
      if (data.events) {
        renderAdminEvents(data.events);
      }
      
      if (data.contacts) {
        document.getElementById('contactAddress').value = data.contacts.address;
        document.getElementById('contactEmail').value = data.contacts.email;
        document.getElementById('contactHours').value = data.contacts.hours;
      }
      
      if (data.stripe) {
        document.getElementById('ticketPrice').value = data.stripe.price;
        document.getElementById('stripeKey').value = data.stripe.publicKey || '';
      }
    }
  } catch (error) {
    console.error('Errore caricamento:', error);
  }
}

function renderAdminEvents(events) {
  const container = document.getElementById('eventsList');
  container.innerHTML = events.map((e, i) => `
    <div style="margin-bottom:1rem;padding:1rem;border:1px solid var(--line);">
      <input type="text" placeholder="Data" value="${e.date}" data-index="${i}" data-field="date" style="margin-bottom:0.5rem;">
      <input type="text" placeholder="Titolo" value="${e.title}" data-index="${i}" data-field="title" style="margin-bottom:0.5rem;">
      <input type="text" placeholder="Descrizione" value="${e.desc}" data-index="${i}" data-field="desc" style="margin-bottom:0.5rem;">
      <input type="text" placeholder="Tag" value="${e.tag}" data-index="${i}" data-field="tag">
      <button onclick="deleteEvent(${i})" style="margin-top:0.5rem;background:#ff0000;color:white;border:none;padding:0.5rem 1rem;cursor:pointer;">Elimina</button>
    </div>
  `).join('');
}

let currentEvents = [];

async function saveColors() {
  const colors = {
    bg: document.getElementById('colorBg').value,
    fg: document.getElementById('colorFg').value,
    accent: document.getElementById('colorAccent').value
  };
  
  await db.collection('site').doc('config').set({ colors }, { merge: true });
  alert('Colori salvati!');
}

async function saveHero() {
  const hero = {
    title: document.getElementById('heroTitle').value,
    subtitle: document.getElementById('heroSubtitle').value
  };
  
  await db.collection('site').doc('config').set({ hero }, { merge: true });
  alert('Hero salvato!');
}

async function saveEvents() {
  const inputs = document.querySelectorAll('#eventsList input');
  const events = [];
  let currentEvent = {};
  
  inputs.forEach(input => {
    const field = input.dataset.field;
    currentEvent[field] = input.value;
    
    if (field === 'tag') {
      events.push(currentEvent);
      currentEvent = {};
    }
  });
  
  await db.collection('site').doc('config').set({ events }, { merge: true });
  alert('Eventi salvati!');
}

function addEvent() {
  const container = document.getElementById('eventsList');
  const index = container.children.length;
  const div = document.createElement('div');
  div.style.cssText = 'margin-bottom:1rem;padding:1rem;border:1px solid var(--line);';
  div.innerHTML = `
    <input type="text" placeholder="Data" data-index="${index}" data-field="date" style="margin-bottom:0.5rem;">
    <input type="text" placeholder="Titolo" data-index="${index}" data-field="title" style="margin-bottom:0.5rem;">
    <input type="text" placeholder="Descrizione" data-index="${index}" data-field="desc" style="margin-bottom:0.5rem;">
    <input type="text" placeholder="Tag" data-index="${index}" data-field="tag">
    <button onclick="this.parentElement.remove()" style="margin-top:0.5rem;background:#ff0000;color:white;border:none;padding:0.5rem 1rem;cursor:pointer;">Elimina</button>
  `;
  container.appendChild(div);
}

function deleteEvent(index) {
  const inputs = document.querySelectorAll(`#eventsList input[data-index="${index}"]`);
  inputs.forEach(input => input.parentElement.remove());
}

async function saveContacts() {
  const contacts = {
    address: document.getElementById('contactAddress').value,
    email: document.getElementById('contactEmail').value,
    hours: document.getElementById('contactHours').value
  };
  
  await db.collection('site').doc('config').set({ contacts }, { merge: true });
  alert('Contatti salvati!');
}

async function saveAnalytics() {
  const gaId = document.getElementById('gaId').value;
  await db.collection('site').doc('config').set({ analytics: { gaId } }, { merge: true });
  alert('Analytics salvato! Aggiorna la pagina per applicare.');
}

async function saveStripe() {
  const stripe = {
    price: document.getElementById('ticketPrice').value,
    publicKey: document.getElementById('stripeKey').value
  };
  
  await db.collection('site').doc('config').set({ stripe }, { merge: true });
  alert('Pagamenti salvati!');
}

