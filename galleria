async function payWithStripe() {
  try {
    const doc = await db.collection('site').doc('config').get();
    const data = doc.data();
    
    if (!data.stripe || !data.stripe.publicKey) {
      alert('Configurazione Stripe mancante');
      return;
    }
    
    // Qui servirebbe un backend per creare la sessione Stripe
    // Per ora mostro un messaggio
    alert('Per pagamenti Stripe sicuri serve un backend Node.js.\n\nConfigura una Cloud Function Firebase o un server Express per creare le sessioni Stripe in modo sicuro.');
    
  } catch (error) {
    console.error('Errore pagamento:', error);
    alert('Errore durante il pagamento');
  }
}

