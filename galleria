                            <!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GALLERIA URBANA — Scicli</title>

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore-compat.js"></script>

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=GA_MEASUREMENT_ID"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'GA_MEASUREMENT_ID');
</script>

<link href="https://cdn.jsdelivr.net/npm/@fontsource/space-grotesk@5.0.0/index.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/@fontsource/space-mono@5.0.0/index.min.css" rel="stylesheet">

<style>
  :root {
    --bg: #0a0a0a;
    --fg: #ededea;
    --accent: #ff4a1c;
    --muted: #6b6b68;
    --line: #1f1f1d;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body {
    font-family: 'Space Grotesk', sans-serif;
    background: var(--bg);
    color: var(--fg);
    overflow-x: hidden;
  }

  /* ADMIN PANEL */
  .admin-panel {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--bg);
    z-index: 10000;
    overflow-y: auto;
  }

  .admin-panel.active { display: block; }

  .admin-header {
    padding: 2rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .admin-title {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .admin-logout {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 0.8rem 1.5rem;
    font-weight: 700;
    cursor: pointer;
  }

  .admin-content {
    padding: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .admin-section {
    background: #111;
    padding: 1.5rem;
    border: 1px solid var(--line);
  }

  .admin-section h3 {
    margin-bottom: 1rem;
    color: var(--accent);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .admin-field {
    margin-bottom: 1rem;
  }

  .admin-field label {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .admin-field input,
  .admin-field textarea,
  .admin-field select {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--fg);
    padding: 0.8rem;
    font-family: inherit;
  }

  .admin-field input[type="color"] {
    height: 50px;
    cursor: pointer;
  }

  .admin-save {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 1rem 2rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    margin-top: 1rem;
  }

  /* LOGIN */
  .login-screen {
    position: fixed;
    inset: 0;
    background: var(--bg);
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-box {
    background: #111;
    padding: 3rem;
    border: 1px solid var(--line);
    width: 100%;
    max-width: 400px;
  }

  .login-box h2 {
    margin-bottom: 2rem;
    text-align: center;
  }

  /* SITO NORMALE */
  .site-content { display: block; }
  .site-content.hidden { display: none; }

  nav {
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.2em;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    color: var(--fg);
    text-decoration: none;
    font-size: 0.85rem;
  }

  section {
    padding: 6rem 2rem;
    min-height: 100vh;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 2rem;
  }

  .hero-subtitle {
    font-family: 'Space Mono', monospace;
    color: var(--muted);
    letter-spacing: 0.2em;
  }

  /* EVENTS TICKER */
  .ticker {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1.5rem 0;
    overflow: hidden;
    margin-top: 4rem;
  }

  .ticker-track {
    display: flex;
    gap: 3rem;
    animation: scroll 30s linear infinite;
    white-space: nowrap;
  }

  @keyframes scroll {
    to { transform: translateX(-50%); }
  }

  .ticker-item {
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
  }

  .ticker-item .date {
    color: var(--accent);
    font-weight: 700;
    margin-right: 1rem;
  }

  /* EVENTS LIST */
  .events-list {
    max-width: 900px;
    margin: 0 auto;
  }

  .event-card {
    border-bottom: 1px solid var(--line);
    padding: 2rem 0;
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 2rem;
    align-items: center;
  }

  .event-date {
    font-family: 'Space Mono', monospace;
    color: var(--accent);
    font-size: 0.9rem;
  }

  .event-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .event-desc {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .event-tag {
    font-size: 0.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* CONTACT FORM */
  .contact-section {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .contact-info h3 {
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
  }

  .contact-info p {
    margin-bottom: 1rem;
    color: var(--muted);
  }

  /* FORMSUBMIT IFRAME */
  .form-container {
    width: 100%;
    height: 500px;
    border: 1px solid var(--line);
  }

  .form-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* MAP */
  .map-container {
    width: 100%;
    height: 400px;
    margin-top: 3rem;
    border: 1px solid var(--line);
  }

  .map-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ANALYTICS */
  .analytics-section {
    max-width: 1200px;
    margin: 0 auto;
  }

  .analytics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .stat-card {
    background: #111;
    padding: 2rem;
    border: 1px solid var(--line);
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* PAYMENT */
  .payment-section {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .payment-btn {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 1.2rem 3rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 2rem;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    margin-bottom: 3rem;
    text-align: center;
  }
</style>
</head>
<body>

<!-- LOGIN SCREEN -->
<div class="login-screen" id="loginScreen" style="display:none;">
  <div class="login-box">
    <h2>Admin Login</h2>
    <form id="loginForm">
      <div class="admin-field">
        <label>Email</label>
        <input type="email" id="loginEmail" required>
      </div>
      <div class="admin-field">
